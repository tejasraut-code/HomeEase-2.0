@model CategoryViewModel

<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <div class="container">


            <input asp-for="CategoryId" type="hidden" />

        <div class="mb-3">
            <label class="form-label" asp-for="CategoryName">Category Name :</label>
            <input asp-for="CategoryName" class="form-control" />
            <span class="text-danger" asp-validation-for="CategoryName"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Description">Description :</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span class="text-danger" asp-validation-for="Description"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="BrowserImage">Image :</label>
            <input type="file" asp-for="BrowserImage" class="form-control" />
            <span class="text-danger" asp-validation-for="BrowserImage"></span>
        </div>

            <input asp-for="ExistingImage" type="hidden" />

        <button type="submit" class="btn btn-primary">Update</button>

    </div>
</form>