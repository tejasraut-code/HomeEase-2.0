@{
    ViewData["Title"] = "Service Page";
}
@model ServicePageViewModel
@section Styles{
    <link href="~/css/service.css" rel="stylesheet" />
}

 <div class="container p-4">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class=" alert alert-warning" role="alert">@TempData["ErrorMessage"]</div>
    }
    <div id="serviceMessage" class="alert alert-warning d-none" role="alert"></div>

    @* dropbox fillter *@
    <div class="d-flex justify-content-evenly">
         <h2 id="categoryHeading">@ViewBag.categoryName</h2>
         <div>
            <select class="form-select" asp-for="SelectedCategoryId" asp-items="Model.CategoryOptions" >
                <option value="">All Category</option>
            </select>
         </div>
    </div>

    <h3 class="h3 text-center"> Book A Service </h3>
    <a class="btn btn-outline-primary" asp-controller="Service" asp-action="Create">Create a New Service.</a>

    @* servcie-card *@
    <div class="row" id="serviceList">
       @if(!Model.Services.Any())
       {
            <p>No Service Available in this Category.</p>
       }
       else
       {
            @foreach (var item in Model.Services)
            {
                <div class="col-12 col-sm-6 col-lg-4 mb-4 service-card">
                    <div class="card h-100 service-card-panel">
                        <div class="service-image-frame">
                            @if (!string.IsNullOrEmpty(item.ExistingImage))
                            {
                                <img src="~/images/@item.ExistingImage" class="service-image" alt="@item.ServiceName" loading="lazy" />
                            }
                            else
                            {
                                <div class="service-image-empty">
                                    No Image Available
                                </div>
                            }
                        </div>
                        <div class="card-header service-card-header">
                            <h3 class="card-title">@item.ServiceName</h3>
                            @* <p hidden>@item.ServiceId</p> *@
                            <p class="card-text">@item.CategoryName</p>
                        </div>
                        <div class="card-body service-card-body">
                            <p class="card-text">@item.Description</p>
                            <p class="card-text"><b>Rs.</b>@item.Price/-</p>
                            <p class="card-text">Estimated Time Required <br /> Days:@item.DurationView.Days  Hours:@item.DurationView.Hours    Minutes:@item.DurationView.Minutes </p>
                        </div>
                        <div class="card-footer service-card-actions">

                            <a class="btn btn-primary booking-action" asp-action="Create" asp-controller="Booking" asp-route-serviceId="@item.ServiceId">Book an Appoinment</a>

                            <a asp-action="Edit" asp-route-id="@item.ServiceId" class="btn btn-warning">Edit</a>

                            <form class="service-delete-form" 
                                asp-action="Delete" asp-route-id="@item.ServiceId" method="post" onsubmit="return confirm('Are you sure you want to delete this service?')">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>

                        </div>
                    </div>
                </div>
            }

       }
      
      </div>

    </div>


@section Scripts{
    <script>

        $(document).on("click",".delete-service",function()
        {
            var serviceId = $(this).attr("data-service-id");
            console.log(serviceId);

            var serviceCard = $(this).closest(".service-card");

            if(!confirm("Are you sure you want to delete this service ?")){
                return;
            }
            // service-delete
            $.ajax({
                url : "/Service/Delete",
                type : "POST",
                data : { id : serviceId },

                success : function(response){
                    // console.log(response);

                    if(response){
                        serviceCard.remove(response);
                        console.log("Service Delete Successfull");

                        if($(".serviceList  .service-card").length === 0){
                            $(".service-card").html(
                                "<p>No Service Availabe in this Category.</p>"
                            );
                        }

                    }
                },

                error : function(responce){

                    var message = "This service cannot be deleted because it is linked to provider or booking.";

                    if(responce.responseJSON && responce.responseJSON.message){
                        message = responce.responseJSON.message;
                    }

                    $("#serviceMessage").removeClass("d-none").text(message);

                    console.log("Delete request Failed",responce.status);
                }
            });

        });

        $("#SelectedCategoryId").on("change",function (){
                    var categoryId =  $(this).val();

                    console.log(categoryId);
                    // service
                    $.ajax({
                        url:"/api/services",
                        type: "GET",
                        data :{
                            categoryId: categoryId
                        },

                        success : function(data){

                            // console.log(data);

                            // $("#serviceList").html("<h4>Ajax Worked and Service List Replaced</h4>");
                            // console.log($("#serviceList").length);

                            // console.log("API SUCCESS");
                            // console.log("Number of services:", data.length);

                            // console.log("serviceList found:", $("#serviceList").length);
                               
                            // data.forEach(function (item, index) {
                            // console.log("Loop:", index, item.serviceName); });

                            $("#serviceList").empty();

                           var categoryName = $("#SelectedCategoryId option:selected").text();
                           $("#categoryHeading").text(categoryName);

                            if(data.length === 0){
                                $("#serviceList").html(
                                    "<p>No Service Available in this Category.</p>"
                                );
                                return;
                            }

                            data.forEach(function (item){

                                console.log(item.serviceName);
                                console.log(item.categoryName);
                                console.log(item.price);

                                var card=`
                                <div class="col-12 col-sm-6 col-lg-4 mb-4 service-card">
                                    <div class="card h-100 service-card-panel">
                                        <div class="service-image-frame">
                                            ${item.image && item.image.length !== 0 
                                                ? `<img src="/images/${item.image}" class="service-image loading:"lazy">`
                                                : `<div class="service-image-empty">No Image Available</div>`
                                            }
                                        </div>
                                        <div class="card-body service-card-body">
                                        <h4>${item.serviceName}</h4>
                                        <p>${item.categoryName}</p>
                                        <p>${item.description}</p>
                                        <p> <b>Rs.</b> ${item.price}/-</p>
                                        <p style="margin-bottom:0;">Estimated Time Required </p>
                                        <div class="service-duration">
                                            <p>Day:${item.duration.days}</p>
                                            <p>Hours:${item.duration.hours}</p>
                                            <p>Minutes:${item.duration.minutes}</p>
                                        </div>
                                        </div>
                                        <div class="card-footer service-card-actions">

                                            <a href="/Booking/Create?serviceId=${item.serviceId}" class="btn btn-primary booking-action">Book an Appointment</a>
                                            <a href="/Service/Edit/${item.serviceId}" class="btn btn-warning">Edit</a>
                                            <button type="button" class="btn btn-danger delete-service service-card-form" data-service-id="${item.serviceId}" >Delete</button>
                                            
                                        </div>
                                    </div>
                                </div>`;

                                $("#serviceList").append(card);

                            });
                        },
                            

                        error: function(){
                            console.log("Error Loading services");
                        }
                    });
                });
    </script>
}