@model ProviderDashboardViewModel



<div class="container">

    <h2 class="text-center">Service Provider Dashboard</h2>

    <div class="card p-3 shadow">
        <div class="card-header d-flex justify-content-end">
            <h3>Wellcome, @Model.ProviderName</h3>
        </div>
        @if(ViewBag.Message != null)
        {
            <div class="alert alert-info">
                @ViewBag.Message
            </div>
        }
        <div class="card-body">
            <h4 class="card-title">Profile</h4>

            <div class="row mb-3">
                <div class="col-md-4">
                    <p>Experience: @Model.ExperienceYears Years</p>
                </div>
                <div class="col-md-4">
                    <p>Service Area: @Model.ServiceArea</p>
                </div>
            </div>
            <div class="col-md-8">
                <p>Bio: @Model.Bio</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                @foreach(var item in Model.ServiceName)
                {
                    <span class="badge bg-secondary p-2 ">@item</span>
                }
            </div>
        </div>
    </div>
</div>