@model ProviderRegisterViewModel

<form method="post" asp-action="Register">
    <div class="container py-4">

        <div class="row justify-content-center">
            <div class="col-lg-9">

                <div class="card shadow">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-4">Service Provider Registion Page</h2>


                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" asp-for="UserName">Name: </label>
                                <input class="form-control" asp-for="UserName" />
                                <span class="text-danger" asp-validation-for="UserName"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" asp-for="Mobile">Mobile Number: </label>
                                <input class="form-control" asp-for="Mobile" />
                                <span class="text-danger" asp-validation-for="Mobile"></span>
                            </div>
                            
                        </div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label" asp-for="EmailId">EmailID: </label>
                                <input class="form-control" asp-for="EmailId" />
                                <span class="text-danger" asp-validation-for="EmailId"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" asp-for="City">City: </label>
                                <input class="form-control" asp-for="City" />
                                <span class="text-danger" asp-validation-for="City"></span>
                            </div>
                        </div>


                        <div class="mb-3">
                            <label class="form-label" asp-for="Address">Address: </label>
                            <textarea class="form-control" asp-for="Address"></textarea>
                            <span class="text-danger" asp-validation-for="Address"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" asp-for="Password">Password: </label>
                                <input class="form-control" asp-for="Password" type="password" />
                                <span class="text-danger" asp-validation-for="Password"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" asp-for="ConfirmPassword">Confirm Password: </label>
                                <input class="form-control" asp-for="ConfirmPassword" type="password" />
                                <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                            </div>
                        </div>


                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" asp-for="ExperienceYears">Experience Years: </label>
                                <input class="form-control" asp-for="ExperienceYears" min="0" max="50" type="number" />
                                <span class="text-danger" asp-validation-for="ExperienceYears"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" asp-for="ServiceArea">Service Area: </label>
                                <input class="form-control" asp-for="ServiceArea" />
                                <span class="text-danger" asp-validation-for="ServiceArea"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="Bio">Bio: </label>
                            <textarea class="form-control" asp-for="Bio"></textarea>
                            <span class="text-danger" asp-validation-for="Bio"></span>
                        </div>

                        <div class="mt-4 mb-3">
                            <h4>Service You Provide</h4>
                            <p class="text-muted">Select one or more servcies.</p>

                            <div class="border rounded p-3">
                                <div class="row">
                                    
                                    @foreach (var item in Model.ServiceOptions)
                                    {
                                        <div class="col-md-6 col-lg-4 mb-2">

                                            <div class="form-check">

                                                <input type="checkbox" class="form-check-input mb-1" value="@item.Value" id="service-@item.Value" name="SelectedServiceIds" />

                                                <label class="form-check-label" asp-for="service-item.Value ">@item.Text</label>

                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>

                            <span class="text-danger" asp-validation-for="SelectedServiceIds"></span>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button class="btn btn-primary px-4">Register a Provider</button>
                        </div>
                        

                    </div>

                    </div>
                </div>

            </div>
        </div>

</form>