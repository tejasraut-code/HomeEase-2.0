@model List<BookingIndexViewModel>

<div class="container">
    <h2>My Bookings</h2>
    
    <div class="row">
        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No Booking History Available.
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-12 col-lg-6 mb-3">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center gap-2">
                            <h5 class="card-title mb-0">@item.ServiceName</h5>
                            @if(item.BookingStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark p-2">@item.BookingStatus</span>
                            }
                            else if(item.BookingStatus == "Completed")
                            {
                                <span class="badge bg-success p-2">@item.BookingStatus</span>
                            }
                            else if (item.BookingStatus == "Cancelled")
                            {
                                <span class="badge bg-danger p-2">@item.BookingStatus</span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="mb-3">Price: ₹ @item.Price/-</h5>

                            <p class="mb-2">Booked On: @item.CreateAt.ToString("dd MM yyyy , hh:mm tt")</p>
                            <p class="mb-2">Scheduled For: @item.ScheduledFor.ToString("dd MM yyyy , hh:mm tt")</p>
                            <p class="mb-2">Duration: @item.DurationView.Days Day @item.DurationView.Hours Hours @item.DurationView.Minutes Minutes</p>
                            <p class="mb-2">Address: @item.ServiceAddress</p>
                            @if(!string.IsNullOrWhiteSpace(item.CustomerNote))
                            {
                                <p class="mb-2">Note: @item.CustomerNote</p>
                            }
                        </div>
                        @if(item.BookingStatus == "Pending")
                        {
                            <div class="card-footer">
                                <form method="post" asp-action="Cancel" asp-controller="Booking" asp-route-bookingId="@item.BookingId" onsubmit="return confirm('Are you sure you want to cancel this Booking?')">

                                  <button type="submit" class="btn btn-outline-danger">Cancel Booking</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        } 
    </div>
</div>